DATABASE_URL=postgresql://ipfilter:ipfilter_local@localhost:5432/ipfilter
REDIS_URL=redis://localhost:6379/0
ADMIN_USERNAME=admin
# 初始化前请设置至少 12 位密码
ADMIN_PASSWORD=
API_URL=http://127.0.0.1:8081
API_ADDR=127.0.0.1:8081
APP_ORIGIN=http://localhost:3000
# 正式部署使用 production，并通过 HTTPS 访问
APP_ENV=development

# 代理节点检测的出口网卡；本机开了 TUN 时填写物理网卡（如 macOS 的 en0）
# 留空使用系统路由。该设置仅作用于代理节点检测。
PROBE_INTERFACE=

# 华为云 DNS：仅由 Go API 读取，请使用有 DNS 查询及记录增删改权限的 IAM 用户
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
HUAWEICLOUD_DNS_REGION=cn-north-4
# 可选；留空时由 SDK 根据区域查询项目 ID
HUAWEICLOUD_PROJECT_ID=
