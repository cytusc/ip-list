DATABASE_URL=postgresql://ipfilter:ipfilter_local@localhost:5432/ipfilter
REDIS_URL=redis://localhost:6379/0
ADMIN_USERNAME=admin
# 初始化前请设置至少 12 位密码
ADMIN_PASSWORD=
WORKER_URL=http://127.0.0.1:8082
INTERNAL_ADDR=127.0.0.1:8082
APP_ORIGIN=http://localhost:3000
# 正式部署使用 production，并通过 HTTPS 访问
APP_ENV=development

# Rust 控制面：静态页面、认证、CRUD、聚合查询与探针上报；Go worker 只保留 mihomo 执行
CONTROL_ADDR=127.0.0.1:8088
# Rust 控制面 PostgreSQL 连接池上限，按服务器内存调整
CONTROL_DB_POOL_SIZE=8
WEB_DIR=out
# 必须与 Go worker 使用同一个值；openssl rand -hex 32
CONTROL_INTERNAL_TOKEN=
# 探针安装包目录（生产为 /opt/ip-list-current/bin/latency-probe）
PROBE_BIN_DIR=bin/latency-probe
PROBE_SCRIPT_DIR=scripts/latency-probe

# 代理节点检测的出口网卡；本机开了 TUN 时填写物理网卡（如 macOS 的 en0）
# 留空使用系统路由。该设置仅作用于代理节点检测。
PROBE_INTERFACE=

# 华为云 DNS：仅由 Go worker 读取，请使用有 DNS 查询及记录增删改权限的 IAM 用户
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
HUAWEICLOUD_DNS_REGION=cn-north-4
# 可选；留空时由 SDK 根据区域查询项目 ID
HUAWEICLOUD_PROJECT_ID=
